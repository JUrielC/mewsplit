# Desarrollo: fija puerto y token para no reescribir esto en cada reinicio.
#   cd backend && MEWSPLIT_PORT=8000 MEWSPLIT_TOKEN=dev-token .venv/bin/python -m mewsplit.api
#
# Next lee estas variables al ARRANCAR: si las cambias, reinicia `next dev`.
#
# En escritorio no se usan: el backend toma un puerto libre y Tauri inyecta
# puerto y token en window.__MEWSPLIT__ desde la línea MEWSPLIT_READY.
NEXT_PUBLIC_MEWSPLIT_API=http://127.0.0.1:8000
NEXT_PUBLIC_MEWSPLIT_TOKEN=dev-token
