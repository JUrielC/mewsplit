# Normalmente NO necesitas este archivo.
#
# next.config.ts lee backend/.env, que es la fuente única de puerto y token
# en desarrollo. Configura allí y las dos puntas quedan sincronizadas.
#
# Copia esto a .env.local solo para apuntar a un backend que no sea el local
# (por ejemplo el Space de Hugging Face). Lo que pongas aquí gana sobre
# backend/.env.
#
# NEXT_PUBLIC_MEWSPLIT_API=https://mi-space.hf.space
# NEXT_PUBLIC_MEWSPLIT_TOKEN=
