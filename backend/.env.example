# Fuente única de configuración en desarrollo.
#
# Lo leen las dos puntas:
#   - backend/mewsplit/api.py al arrancar
#   - frontend/next.config.ts al arrancar `next dev`
#
# Copia este archivo a backend/.env y ajusta lo que necesites.
# El entorno real gana sobre el archivo: MEWSPLIT_PORT=9000 en la línea de
# comandos pisa lo que ponga aquí.

# Puerto fijo. Sin esto el backend toma uno libre al azar y el frontend deja
# de encontrarlo. En escritorio NO se define: Tauri necesita el puerto
# dinámico y lo lee de la línea MEWSPLIT_READY.
MEWSPLIT_PORT=8000

# Token fijo. Sin esto se genera uno aleatorio en cada arranque.
MEWSPLIT_TOKEN=dev-token

# Origen permitido por CORS. Ojo: para el navegador localhost y 127.0.0.1 son
# orígenes distintos.
# MEWSPLIT_ORIGINS=http://localhost:3000

# Caché de checkpoints y directorio de trabajos.
# MEWSPLIT_MODEL_DIR=~/.cache/mewsplit/models
# MEWSPLIT_WORK_DIR=/tmp/mewsplit
